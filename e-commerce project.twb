            <column-instance column='[sku_revenue]' derivation='Sum' name='[pcto:sum:sku_revenue:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column caption='Sku Revenue' datatype='real' name='[sku_revenue]' role='measure' type='quantitative' />
            <column-instance column='[sku_revenue]' derivation='Sum' name='[sum:sku_revenue:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0snujk20fillc0180bavc0jl1o97].[none:description:nk]'>
            <groupfilter count='20' end='top' function='end' units='records' user:ui-marker='end' user:ui-top-by-field='true'>
              <groupfilter direction='DESC' expression='SUM([cumulative_revenue_share])' function='order' user:ui-marker='order'>
                <groupfilter function='level-members' level='[none:description:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
              </groupfilter>
